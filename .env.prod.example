# ======================================================================
# Минитендер.рф — production environment template
# Скопируйте в .env.prod на сервере и заполните реальными значениями
# ======================================================================

# ---------- Django ----------
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=CHANGE_ME_STRONG_RANDOM_STRING
DEBUG=False

# ---------- База данных (PostgreSQL) ----------
DB_NAME=minitender
DB_USER=minitender
DB_PASSWORD=CHANGE_ME

# ---------- Внешние API ----------
# DeepSeek LLM (парсинг, ассистент) — https://platform.deepseek.com
LLM_API_KEY=sk-CHANGE_ME
# DaData (верификация поставщиков) — https://dadata.ru
DADATA_TOKEN=CHANGE_ME
# 2GIS (геокодер + каталог поставщиков) — https://dev.2gis.ru
GEOCODER_API_KEY=CHANGE_ME

# ---------- Email (SMTP Beget) ----------
EMAIL_HOST=smtp.beget.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=rfq@minitender.ru
EMAIL_HOST_PASSWORD=CHANGE_ME
DEFAULT_FROM_EMAIL=Minitender RFQ <rfq@minitender.ru>
INBOUND_EMAIL_DOMAIN=in.minitender.ru

# Входящие webhook-секреты — обязательны для прода
INBOUND_EMAIL_WEBHOOK_SECRET=CHANGE_ME

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
USE_CELERY=true

# ---------- Security ----------
SECURE_SSL_REDIRECT=true

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_2GIS_KEY=CHANGE_ME
FRONTEND_URL=https://minitender.ru
