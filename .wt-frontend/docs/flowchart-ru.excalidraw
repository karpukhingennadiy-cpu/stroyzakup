      ]
    },
    {
      "type": "text",
      "id": "52",
      "x": 575,
      "y": 638,
      "width": 250,
      "height": 80,
      "text": "Формула оценки:\n▶ Совпадение категорий: 50 баллов\n▶ Близость доставки: 30 баллов\n▶ Рейтинг поставщика: 10 баллов\n▶ Полнота профиля: 10 баллов\nИтого: 0–100 баллов",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "51",
