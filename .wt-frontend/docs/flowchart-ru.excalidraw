    {
      "type": "text",
      "id": "25",
      "x": 190,
      "y": 238,
      "width": 360,
      "height": 62,
      "text": "1. Создание заявки\nКлиент вводит список материалов\nСтатус: Черновик",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "24",
      "originalText": "1. Создание заявки\nКлиент вводит список материалов\nСтатус: Черновик",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "26",
      "x": 600,
      "y": 240,
      "text": "POST /api/requests/",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#888",
      "originalText": "POST /api/requests/",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "27",
      "x": 600,
      "y": 260,
      "text": "Код RFQ-XXXXXX",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#aaa",
      "originalText": "Код RFQ-XXXXXX",
      "autoResize": true
    },
    {
      "type": "text",
      "id": "28",
      "x": 600,
      "y": 278,
      "text": "генерируется автоматом",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#aaa",
      "originalText": "генерируется автоматом",
      "autoResize": true
    },
