[Unit]
Description=Minitender Celery worker
After=network.target redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/minitender/backend
EnvironmentFile=/opt/minitender/.env
ExecStart=/opt/minitender/backend/.venv/bin/celery -A config worker --loglevel=info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
