# Django
SECRET_KEY=CHANGE...n
# Database (PostgreSQL)
DB_NAME=minitender
DB_USER=minitender
DB_PASSWORD=CHANGE...n
# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Email SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_PASSWORD=CHANGE...r noreply@minitender.ru>
CELERY_BROKER_URL=redis://localhost:6379/0

# Email SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=CHANGE...nder <noreply@minitender.ru>
INBOUND_EMAIL_DOMAIN=in.minitender.ru

# LLM (DeepSeek)
LLM_API_KEY=CHANGE...n
# DaData (company verification)
DADATA_TOKEN=CHANGE...n
# Yandex (maps + geocoding)
YANDEX_API_KEY=CHANGE...n
# 2GIS (business catalog)
GIS_API_KEY=CHANGE...n
# DKIM (email signing) - keep private key outside repo!
DKIM_PRIVATE_KEY_PATH=/etc/minitender/secrets/dkim_private.pem

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Docker PostgreSQL
POSTGRES_PASSWORD=CHANGE...n
# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Yandex Maps (optional — map disabled if empty)
NEXT_PUBLIC_2GIS_KEY=
