# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=minitender
DB_USER=minitender
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# LLM (DeepSeek)
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Minitender RFQ <rfq@minitender.ru>
INBOUND_EMAIL_DOMAIN=in.minitender.ru

# DaData (company verification)
DADATA_TOKEN=your-dadata-token

# Yandex (maps + geocoding)
YANDEX_API_KEY=your-yandex-api-key

# 2GIS (business catalog)
GIS_API_KEY=your-2gis-key

# DKIM (email signing) - keep private key in .env, never commit!
DKIM_PRIVATE_KEY_PATH=/path/to/dkim_private.pem

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
