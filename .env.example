# ======================================================================
# Stroyzakup — пример переменных окружения (.env.example)
# Скопируйте в .env и заполните реальными значениями.
# НЕ храните реальные секреты в репозитории!
# ======================================================================

# ---------- Backend: Django ----------
DJANGO_SECRET_KEY=CHANGE_ME-вы-длинная-случайная-строка
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ---------- Backend: внешние API ----------
# DaData (проверка контрагентов) — https://dadata.ru
DADATA_TOKEN=CHANGE_ME_dadata_token
# Yandex Maps / Геокодер
YANDEX_API_KEY=CHANGE_ME_yandex_api_key
# LLM (DeepSeek), опционально
LLM_API_KEY=CHANGE_ME_llm_api_key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# ---------- Backend: база данных (PostgreSQL) ----------
DB_NAME=stroyzakup
DB_USER=stroyzakup
DB_PASSWORD=CHANGE_ME_db_password
DB_HOST=localhost
DB_PORT=5432

# ---------- Backend: Redis / Celery ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ---------- Backend: Email SMTP ----------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME_email_password
DEFAULT_FROM_EMAIL=Stroyzakup <noreply@example.com>
INBOUND_EMAIL_DOMAIN=in.example.com

# ---------- Frontend ----------
NEXT_PUBLIC_2GIS_KEY=CHANGE_ME_2gis_key
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ---------- CORS / CSRF ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
