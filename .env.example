# Django
SECRET_KEY=CHANGE_ME_TO_LONG_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=minitender
DB_USER=minitender
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
FRONTEND_URL=http://localhost:3000

# LLM (DeepSeek)
LLM_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# Email SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME_APP_PASSWORD
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Minitender <noreply@minitender.ru>
INBOUND_EMAIL_DOMAIN=in.minitender.ru

# DaData (company verification)
DADATA_TOKEN=CHANGE_ME_DADATA_TOKEN

# Yandex (maps + geocoding)
YANDEX_API_KEY=CHANGE_ME_YANDEX_API_KEY

# 2GIS (business catalog)
GIS_API_KEY=CHANGE_ME_2GIS_API_KEY

# DKIM (email signing) - keep private key outside repo!
DKIM_PRIVATE_KEY_PATH=/etc/minitender/secrets/dkim_private.pem

# PostgreSQL password for Docker
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
