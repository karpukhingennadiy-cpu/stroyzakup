[Unit]
Description=Minitender Celery Worker
After=network.target redis.service

[Service]
User=minitender
Group=minitender
WorkingDirectory=/opt/minitender/backend
Environment="DJANGO_SETTINGS_MODULE=config.settings.prod"
EnvironmentFile=/opt/minitender/.env
ExecStart=/opt/minitender/backend/.venv/bin/celery -A config worker -l info -c 4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
