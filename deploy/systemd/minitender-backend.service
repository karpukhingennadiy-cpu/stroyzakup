[Unit]
Description=Minitender backend gunicorn
After=network.target postgresql.service redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/minitender/backend
EnvironmentFile=/opt/minitender/.env
ExecStart=/opt/minitender/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
